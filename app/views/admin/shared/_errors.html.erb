<% if record.errors.any? %>
  <div class="mb-4 px-3 py-2 bg-red-50 text-red-800 rounded">
    <p class="font-medium">No se pudo guardar:</p>
    <ul class="list-disc ml-5">
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
