<% content_for :title, "Pagos" %>

<div class="page-header">
  <h1 class="page-title">Pagos</h1>
  <%= link_to "Registrar pago", new_admin_payment_path, class: "btn-primary" %>
</div>

<h2 class="section-title mt-0">En revisión</h2>
<% if @in_review.any? %>
  <p class="text-sm text-gray-500 mb-2">Informados por los clientes desde el portal. No imputan hasta que se confirman.</p>
  <table class="data-table mb-6">
    <thead><tr><th>Fecha</th><th>Cliente</th><th>Informado por</th><th>Medio</th><th class="num">Monto</th><th></th></tr></thead>
    <tbody>
      <% @in_review.each do |payment| %>
        <tr>
          <td><%= link_to l(payment.paid_on), admin_payment_path(payment), class: "link" %></td>
          <td><%= payment.client.business_name %></td>
          <td><%= payment.registered_by.name %></td>
          <td><%= status_label(payment.payment_method) %></td>
          <td class="num"><%= number_to_currency(payment.amount) %></td>
          <td class="whitespace-nowrap">
            <%= button_to "Confirmar", confirm_admin_payment_path(payment), method: :patch, class: "btn-primary", form: { class: "inline" } %>
            <%= button_to "Rechazar", reject_admin_payment_path(payment), method: :patch, class: "btn-danger", form: { class: "inline" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-sm text-gray-500 mb-6">No hay pagos pendientes de revisión.</p>
<% end %>

<h2 class="section-title">Historial</h2>
<table class="data-table">
  <thead><tr><th>Fecha</th><th>Cliente</th><th>Estado</th><th>Medio</th><th>Registrado por</th><th class="num">Monto</th></tr></thead>
  <tbody>
    <% @payments.each do |payment| %>
      <tr>
        <td><%= link_to l(payment.paid_on), admin_payment_path(payment), class: "link" %></td>
        <td><%= payment.client.business_name %></td>
        <td><%= render "admin/shared/status", status: payment.status %></td>
        <td><%= status_label(payment.payment_method) %></td>
        <td><%= payment.registered_by.name %></td>
        <td class="num"><%= number_to_currency(payment.amount) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
