<% content_for :title, "Clientes" %>

<div class="page-header">
  <h1 class="page-title">Clientes</h1>
  <%= link_to "Nuevo cliente", new_admin_client_path, class: "btn-primary" %>
</div>

<table class="data-table">
  <thead>
    <tr>
      <th>Razón social</th>
      <th>CUIT</th>
      <th>Contacto</th>
      <th>Email</th>
      <th>Estado</th>
      <th class="num">Deuda</th>
    </tr>
  </thead>
  <tbody>
    <% @clients.each do |client| %>
      <tr>
        <td><%= link_to client.business_name, admin_client_path(client), class: "link" %></td>
        <td class="tabular-nums"><%= client.tax_id %></td>
        <td><%= client.contact_name %></td>
        <td><%= client.email %></td>
        <td><%= client.active? ? "Activo" : "Inactivo" %></td>
        <td class="num"><%= number_to_currency(client.debt) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
