<%= form_with model: [ :admin, project ] do |form| %>
  <%= render "admin/shared/errors", record: project %>

  <div class="form-field">
    <%= form.label :client_id %>
    <%= form.collection_select :client_id, Client.order(:business_name), :id, :business_name,
          { prompt: "Elegí un cliente" }, class: "form-input", required: true %>
  </div>
  <div class="form-field">
    <%= form.label :name %>
    <%= form.text_field :name, class: "form-input", required: true %>
  </div>
  <div class="form-field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 3, class: "form-input" %>
  </div>
  <div class="form-field">
    <%= form.label :status %>
    <%= form.select :status, enum_options(Project, :statuses), {}, class: "form-input" %>
  </div>
  <div class="form-field">
    <%= form.label :started_on %>
    <%= form.date_field :started_on, class: "form-input" %>
  </div>
  <div class="form-field">
    <%= form.label :closed_on %>
    <%= form.date_field :closed_on, class: "form-input" %>
  </div>

  <%= form.submit "Guardar", class: "btn-primary" %>
  <%= link_to "Cancelar", project.persisted? ? admin_project_path(project) : admin_projects_path, class: "btn" %>
<% end %>
