<% content_for :title, "Usuarios" %>

<div class="page-header">
  <h1 class="page-title">Usuarios</h1>
  <%= link_to "Nuevo usuario", new_admin_user_path, class: "btn-primary" %>
</div>

<table class="data-table">
  <thead><tr><th>Nombre</th><th>Email</th><th>Rol</th><th>Nivel</th><th>Cliente</th><th></th></tr></thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email_address %></td>
        <td><%= status_label(user.role) %></td>
        <td><%= user.level && status_label(user.level) %></td>
        <td><%= user.client&.business_name %></td>
        <td><%= link_to "Editar", edit_admin_user_path(user), class: "link" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
