<%= form_with model: [ :admin, user ] do |form| %>
  <%= render "admin/shared/errors", record: user %>

  <div class="form-field">
    <%= form.label :name %>
    <%= form.text_field :name, class: "form-input", required: true %>
  </div>
  <div class="form-field">
    <%= form.label :email_address %>
    <%= form.email_field :email_address, class: "form-input", required: true %>
  </div>
  <div class="form-field">
    <%= form.label :role %>
    <%= form.select :role, enum_options(User, :roles), {}, class: "form-input" %>
  </div>
  <div class="form-field">
    <%= form.label :level %>
    <%= form.select :level, enum_options(User, :levels), { include_blank: "No aplica (usuario del portal)" }, class: "form-input" %>
  </div>
  <div class="form-field">
    <%= form.label :client_id %>
    <%= form.collection_select :client_id, Client.order(:business_name), :id, :business_name,
          { include_blank: "Ninguno (equipo interno)" }, class: "form-input" %>
    <p class="text-xs text-gray-500 mt-1">Sólo para usuarios con rol Cliente.</p>
  </div>
  <div class="form-field">
    <%= form.label :password %>
    <%= form.password_field :password, class: "form-input", autocomplete: "new-password",
          placeholder: (user.persisted? ? "Dejar en blanco para no cambiarla" : nil) %>
  </div>
  <div class="form-field">
    <%= form.label :password_confirmation %>
    <%= form.password_field :password_confirmation, class: "form-input", autocomplete: "new-password" %>
  </div>

  <%= form.submit "Guardar", class: "btn-primary" %>
  <%= link_to "Cancelar", admin_users_path, class: "btn" %>
<% end %>
