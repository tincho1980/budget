{
  "info": {
    "_postman_id": "63cb1d9b-f4f2-4e55-93ff-468064b31635",
    "name": "adavra-sales API v1",
    "description": "Portal del cliente. Correr primero 'Login' (guarda el token) y 'Mis proyectos' (guarda project_id y budget_id). Credenciales de los seeds: contraseña 'password'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "project_id",
      "value": ""
    },
    {
      "key": "budget_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Sesión",
      "item": [
        {
          "name": "Login · Club Social (presupuesto para aprobar)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email_address\": \"portal@clubsocial.com.ar\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "Devuelve el token. El script lo guarda en la variable {{token}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test(\"Login correcto\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"token\", body.token);"
                ]
              }
            }
          ]
        },
