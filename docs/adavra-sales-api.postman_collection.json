              "host": [
                "{{base_url}}"
              ],
              "path": [
                "budgets",
                "{{budget_id}}"
              ]
            },
            "description": "Ítems facturables agrupados por módulo. Sin tarifas, costos ni tareas internas."
          }
        },
        {
          "name": "Aprobar presupuesto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/budgets/{{budget_id}}/approve",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "budgets",
                "{{budget_id}}",
                "approve"
              ]
            }
          }
        },
        {
          "name": "Rechazar presupuesto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/budgets/{{budget_id}}/reject",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "budgets",
                "{{budget_id}}",
                "reject"
              ]
            }
          }
        }
      ]
