    {
      "name": "2. Proyectos y presupuestos",
      "item": [
        {
          "name": "Mis proyectos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const projects = pm.response.json().projects;",
                  "pm.test(\"Lista de proyectos\", () => pm.response.to.have.status(200));",
                  "if (projects.length) {",
                  "  pm.collectionVariables.set(\"project_id\", projects[0].id);",
                  "  if (projects[0].current_budget) pm.collectionVariables.set(\"budget_id\", projects[0].current_budget.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Detalle del proyecto",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/projects/{{project_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "projects",
                "{{project_id}}"
              ]
            }
          }
        },
        {
          "name": "Presupuesto vigente",
          "request": {
